{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Leadway API",
  "colors": {
    "primary": "#397dff",
    "light": "#5C95FF",
    "dark": "#1E5BD9"
  },
  "appearance": { "default": "light", "strict": false },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://leadwaycrm.com"
  },
  "favicon": "/images/favicon.svg",
  "navbar": {
    "links": [
      { "label": "Portal", "href": "https://app.leadwaycrm.com" },
      { "label": "Soporte", "href": "mailto:soporte@leadwaycrm.com" }
    ],
    "primary": {
      "type": "button",
      "label": "Crear cuenta",
      "href": "https://leadwaycrm.com/signup"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentación",
        "groups": [
          { "group": "Empezar", "pages": ["landing", "authentication"] },
          {
            "group": "Scopes",
            "pages": [
              "scopes/index",
              {
                "group": "Catálogo",
                "pages": [
                  "scopes/ad-manager",
                  "scopes/affiliate-manager",
                  "scopes/ai-agent",
                  "scopes/associations",
                  "scopes/blogs",
                  "scopes/brandboards",
                  "scopes/business-calendars",
                  "scopes/campaigns",
                  "scopes/chat-widget",
                  "scopes/companies",
                  "scopes/contacts",
                  "scopes/conversation-ai",
                  "scopes/conversations",
                  "scopes/courses",
                  "scopes/custom-fields",
                  "scopes/custom-menus",
                  "scopes/email-forms",
                  "scopes/funnels",
                  "scopes/invoice",
                  "scopes/knowledge-base",
                  "scopes/lc-email",
                  "scopes/media-storage",
                  "scopes/objects",
                  "scopes/opportunities",
                  "scopes/payments",
                  "scopes/phone-system",
                  "scopes/products",
                  "scopes/proposals",
                  "scopes/social-planner",
                  "scopes/store",
                  "scopes/studio",
                  "scopes/surveys",
                  "scopes/trigger-links",
                  "scopes/users",
                  "scopes/voice-ai",
                  "scopes/workflows"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Referencia API",
        "openapi": "api-reference/contacts.json"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/leadwaycrm",
      "linkedin": "https://www.linkedin.com/company/leadwaycrm/",
      "youtube": "https://www.youtube.com/@leadwaycrm"
    }
  },
  "seo": {
    "metatags": { "og:image": "/images/og.png" },
    "indexing": "navigable"
  }
}
